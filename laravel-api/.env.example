APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
API_RATE_LIMIT_PER_MINUTE=120

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_TIMEOUT=30
AI_PROVIDER_ORDER=gemini,openai,groq,openrouter
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Choose one: sqlite, mysql, or pgsql
DB_CONNECTION=sqlite
# MySQL/PostgreSQL settings (unused by SQLite)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# SQLite database file (use an absolute path in production)
# DB_DATABASE=/var/www/ecommerce-platform/database/database.sqlite

# Database backup (supports sqlite, mysql, and pgsql)
BACKUP_ENABLED=false
BACKUP_SCHEDULE=02:00
BACKUP_RETENTION_DAYS=14
# BACKUP_DIR=/var/backups/ecommerce-platform

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
AUTH_GUARD=sanctum
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=eco_

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
OUTBOX_JOB_TIMEOUT_SECONDS=120
OUTBOX_LEASE_MINUTES=5
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_DELAY_MINUTES=5

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paymob hosted checkout (use sandbox credentials outside production)
PAYMOB_ENABLED=false
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
PAYMOB_NOTIFICATION_URL="${APP_URL}/api/v1/webhooks/paymob"
PAYMOB_REDIRECTION_URL="${APP_URL}/payment/return"
PAYMOB_TIMEOUT=15

# Kashier hosted payment sessions (use test keys with test hosts)
KASHIER_ENABLED=false
KASHIER_API_BASE_URL=https://test-api.kashier.io
KASHIER_FEP_BASE_URL=https://test-fep.kashier.io
KASHIER_CHECKOUT_BASE_URL=https://payments.kashier.io
KASHIER_MERCHANT_ID=
KASHIER_SECRET_KEY=
KASHIER_PAYMENT_API_KEY=
KASHIER_WEBHOOK_URL="${APP_URL}/api/v1/webhooks/kashier"
KASHIER_REDIRECT_URL="${APP_URL}/payment/return"
KASHIER_TIMEOUT=15

# Bosta shipping provider
BOSTA_ENABLED=false
BOSTA_BASE_URL=https://app.bosta.co
BOSTA_API_KEY=
BOSTA_WEBHOOK_URL="${APP_URL}/api/v1/webhooks/bosta"
BOSTA_WEBHOOK_AUTH_HEADER=Authorization
BOSTA_WEBHOOK_AUTH_VALUE=
BOSTA_TIMEOUT=15

# Social Commerce
SOCIAL_HTTP_TIMEOUT=15
SOCIAL_FACEBOOK_VERIFY_TOKEN=
SOCIAL_INSTAGRAM_VERIFY_TOKEN=
SOCIAL_WHATSAPP_VERIFY_TOKEN=
SOCIAL_FACEBOOK_SEND_URL=
SOCIAL_FACEBOOK_COMMENT_REPLY_URL=https://graph.facebook.com/{comment_id}/comments
SOCIAL_INSTAGRAM_SEND_URL=
SOCIAL_INSTAGRAM_COMMENT_REPLY_URL=https://graph.facebook.com/{comment_id}/replies
SOCIAL_WHATSAPP_SEND_URL=
